{
    "manifest_version": 3,
    "name": "TaskGuard",
    "version": "1.0",
    "description": "A Chrome extension that ensures you stay on task.",
    "permissions": ["storage", "alarms"],
    "icons": {
        "16": "image.png",
        "48": "image.png",
        "128": "image.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "blocked.html",
        "default_title": "TaskGuard",
        "default_icon": {
            "16": "image.png",
            "48": "image.png",
            "128": "image.png"
        }
    }
}